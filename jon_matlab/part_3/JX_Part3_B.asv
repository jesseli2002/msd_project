[mag2, phase2] = bode(C{1}, w_plot);
[mag3, phase3] = bode(results(1).Loop, w_plot);
[mag4, phase4] = bode(C{2}, w_plot);
[mag5, phase5] = bode(results(2).Loop, w_plot);

