%% === Controller bank ===
load('MSD2025_P3_Plant.mat')
load('MSD2025_P3_Plant.mat')
load('MSD2025_P3_Signals.mat')

s = tf('s');

C = {};   % cell array
labels = {};  % legend labels

% ---- Baseline controller ----
C1 = 2750 / s;
C2 = (1 / make_double_pole(4610, 0.01)) * make_double_pole(8000, 1);
C3 = make_notch(6300, 5);
C4 = make_lpf_butter(28000, 2);
C5 = make_ll(300*2*pi, 20*pi/180);

C{1} = balreal(ss(C1)*ss(C2)*ss(C3)*ss(C4)*ss(C5));
labels{1} = 'Original';

% ---- Tuned controller ----
C_6 = make_PI(1, 2*pi*100);
C{2} = C{1} * ss(C_6);
labels{2} = 'PI Adjusted';

% --- Anti-notch -----
% C_7 = make_PI(1, 2*pi*200);
% C{3} = C{1} * ss(C_7);
% labels{3} = 'PI gain 200';

Nc = numel(C);
% t = ts * (num_samples-1);

% pre-allocate 
results = struct();
for i = 1:Nc
    results(i).Loop   = [];
    results(i).S      = [];
    results(i).T      = [];
    results(i).Hd     = [];
    results(i).Hn     = [];
    results(i).e_total = [];
    results(i).PSD_d  = [];
    results(i).PSD_n  = [];
    results(i).PSD_y  = [];
    results(i).CPS_d  = [];
    results(i).CPS_n  = [];
    results(i).CPS_y  = [];
end

d = d(:); n = n(:);

ts = 30e-6;
fs = 1.0/ts;
L = length(d);
t = (0 : L-1)*ts;
f = fs*(0:(L/2))/L;

r_a = 10;          % um
d_a = 20;          % V
n_a = 0.01;        % 10nm = 0.1um

D = fft(d);
N = fft(n);

f_b = f(2:end).';
w_b = 2*pi*f_b;

D_S2 = (1/(fs*L))*abs(D).^2;
D_S1 = D_S2(1:L/2+1); D_S1(2:end-1) = 2*D_S1(2:end-1);
D_S1_trimmed = D_S1(2:end).';

N_S2 = (1/(fs*L))*abs(N).^2;
N_S1 = N_S2(1:L/2+1); N_S1(2:end-1) = 2*N_S1(2:end-1);
N_S1_trimmed = N_S1(2:end).';

f            = f(:);
f_b          = f_b(:);
w_b          = w_b(:);
D_S1_trimmed = D_S1_trimmed(:);
N_S1_trimmed = N_S1_trimmed(:);

f_plot = logspace(log10(1e0), log10(1e4), 1000);
w_plot = 2*pi*f_plot;

%% === Controller sweep ===
for i = 1:Nc
    % Loop shaping
    results(i).Loop = C{i} * G;
    results(i).S    = feedback(1, results(i).Loop);
    results(i).T    = feedback(results(i).Loop, results(i).Loop);

    % Transfer paths
    results(i).Hd = ss(G) * results(i).S;   % y/d
    results(i).Hn = results(i).S;            % y/n

    % Error budget @ 10 Hz
    w_a = 2*pi*10;
    S_mag  = abs(freqresp(results(i).S, w_a));
    T_mag  = abs(freqresp(results(i).T, w_a));
    PS_mag = abs(freqresp(G*results(i).S, w_a));

    e_r = S_mag * r_a;
    e_d = PS_mag * d_a;
    e_n = T_mag * n_a;
    results(i).e_total = norm([e_r, e_d, e_n]);
    fprintf('e_r %d = %.2f nm \n', i, e_r*1000)
    fprintf('e_d %d = %.2f nm \n', i, e_d*1000)
    fprintf('e_n %d = %.4f nm \n', i, e_n*1000)    
    fprintf('e_total %d = %.2f um \n', i, results(i).e_total*1000)

    % Frequency response
    Hd_mag = abs(squeeze(freqresp(results(i).Hd, w_b)));
    Hn_mag = abs(squeeze(freqresp(results(i).Hn, w_b)));

    Hd_mag = Hd_mag(:);
    Hn_mag = Hn_mag(:);

    % PSDs
    results(i).PSD_d = (Hd_mag.^2) .* D_S1_trimmed;
    results(i).PSD_n = (Hn_mag.^2) .* N_S1_trimmed;
    results(i).PSD_y = results(i).PSD_d + results(i).PSD_n;

    % CPS
    results(i).CPS_d = cumtrapz(f_b, results(i).PSD_d);
    results(i).CPS_n = cumtrapz(f_b, results(i).PSD_n);
    results(i).CPS_y = cumtrapz(f_b, results(i).PSD_y);
    max_var = ;

    fprintf('d %d variance = %.4f um^2, stdev = %.4f \n', i, max(results(i).CPS_y), sqrt(max(results(i).CPS_y)))
    fprintf('d %d variance = %.4f um^2, stdev = %.4f \n', i, max(results(i).CPS_y), sqrt(max(results(i).CPS_y)))
    fprintf('d %d variance = %.4f um^2, stdev = %.4f \n', i, max(results(i).CPS_y), sqrt(max(results(i).CPS_y)))
    fprintf('\n')

end


%% A.3 bodeplot Plotting Disturbance Rejection (H_d)

